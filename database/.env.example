# Local XAMPP defaults — copy to database/.env only if you need overrides.
host=127.0.0.1
port=3306
username=root
password=
database=khetha_path

# Production: set these environment variables on the host instead of committing secrets.
# KHETHA_DB_HOST=...
# KHETHA_DB_PORT=3306
# KHETHA_DB_USER=...
# KHETHA_DB_PASSWORD=...
# KHETHA_DB_NAME=khetha_path
# KHETHA_DB_SSL=1
